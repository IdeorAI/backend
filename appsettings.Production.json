{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "api.ideorai.com",
  "Supabase": {
    "Url": "${SUPABASE_URL}",
    "AnonKey": "${SUPABASE_ANON_KEY}",
    "ServiceRoleKey": "${SUPABASE_SERVICE_ROLE_KEY}",
    "JwtSecret": "${SUPABASE_JWT_SECRET}"
  },
  "Auth": {
    "RequireJwt": true,
    "ValidAudience": "authenticated"
  },
  "ConnectionStrings": {
    "SupabaseConnection": "${SUPABASE_CONNECTION_STRING}"
  },
  "DeepSeek": {
    "ApiKey": "${DEEPSEEK_API_KEY}"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://ideorai.com",
      "https://www.ideorai.com",
      "https://frontend-ideor-ais-projects.vercel.app"
    ],
    "VercelPreviewPrefixes": [
      "https://frontend-ideor-ais-projects"
    ]
  },
  "HubSpot": {
    "AccessToken": "${HUBSPOT_ACCESS_TOKEN}"
  },
  "Gemini": {
    "ApiKey": "",
    "ProjectNumber": "",
    "Model": "gemini-2.5-flash"
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Jaeger": {
    "Host": "",
    "Port": ""
  },
  "Tempo": {
    "Endpoint": ""
  },
  "PromptSettings": {
    "UseSimplifiedPrompts": false
  }
}
